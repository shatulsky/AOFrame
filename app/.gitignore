# Standard Android/Gradle/Android Studio generated output - none of this
# is source, all of it is regenerated by a plain build.
*.iml
.gradle/
.kotlin/
build/
/local.properties
.idea/*
!.idea/gitignore.xml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Real runtime config (Immich API key, LAN service endpoints, frame ADB
# address) - never committed. Copy immich-secrets.example.json to
# immich-secrets.json and fill in your own values.
/immich-secrets.json

# soak-test.sh's own output (CSV/gfxinfo dumps) - real-device measurements
# specific to whatever ran the script, not source. See docs/performance-notes.md
# for the curated, generalized findings from this kind of testing.
/soak-results/
